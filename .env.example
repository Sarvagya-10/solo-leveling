# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored. Never commit real keys.
# Every AI feature is optional: the app runs fully without these keys.

# Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
# Optional. Leave empty to auto-select the strongest model your key can access.
GROQ_MODEL=

# SerpAPI key, used with the DuckDuckGo engine (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your-serpapi-key-here

# Permanent PostgreSQL database (required on Streamlit Cloud; optional locally)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional overrides
# SHOGUN_DB_PATH=var/shogun.db
# SHOGUN_TIMEZONE=Asia/Kolkata
# SHOGUN_LOG_LEVEL=INFO
